# ============================================================
# Germes environment template
#
# Copy this file to .env and fill in real/local values.
# Never commit secrets or real credentials.
# ============================================================

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

DATABASE_URL=

# ------------------------------------------------------------
# Supabase
# ------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ------------------------------------------------------------
# OWNER bootstrap
# Used by: scripts/bootstrap-owner.ts
#
# One-time bootstrap for the initial Germes OWNER account.
# ------------------------------------------------------------

GERMES_BOOTSTRAP_OWNER_ID=
GERMES_BOOTSTRAP_OWNER_EMAIL=
GERMES_BOOTSTRAP_OWNER_PASSWORD=

# ------------------------------------------------------------
# Reusable internal-user bootstrap
# Used by: scripts/bootstrap-user.ts
#
# Targets ONE existing Germes User at a time.
# The selected user must already exist in the Germes database
# and already have at least one role assigned.
#
# Example targets:
# SALES / WAREHOUSE / ACCOUNTING / ADMIN / PROCUREMENT
# ------------------------------------------------------------

GERMES_BOOTSTRAP_USER_ID=
GERMES_BOOTSTRAP_USER_EMAIL=
GERMES_BOOTSTRAP_USER_PASSWORD=

# ------------------------------------------------------------
# SALES demo account
# ------------------------------------------------------------

SALES_USER_ID=
SALES_USER_EMAIL=
SALES_USER_PASSWORD=

# ------------------------------------------------------------
# SALES2 demo account
# ------------------------------------------------------------

SALES2_USER_ID=
SALES2_USER_EMAIL=
SALES2_USER_PASSWORD=

# ------------------------------------------------------------
# SALES3 demo account
# ------------------------------------------------------------

SALES3_USER_ID=
SALES3_USER_EMAIL=
SALES3_USER_PASSWORD=

# ------------------------------------------------------------
# WAREHOUSE demo account
# ------------------------------------------------------------

WAREHOUSE_USER_ID=
WAREHOUSE_USER_EMAIL=
WAREHOUSE_USER_PASSWORD=

# ------------------------------------------------------------
# WAREHOUSE2 demo account
# ------------------------------------------------------------

WAREHOUSE2_USER_ID=
WAREHOUSE2_USER_EMAIL=
WAREHOUSE2_USER_PASSWORD=

# ------------------------------------------------------------
# ACCOUNTING demo account
# ------------------------------------------------------------

ACCOUNTING_USER_ID=
ACCOUNTING_USER_EMAIL=
ACCOUNTING_USER_PASSWORD=

# ------------------------------------------------------------
# PROCUREMENT demo account
# ------------------------------------------------------------

PROCUREMENT_USER_ID=
PROCUREMENT_USER_EMAIL=
PROCUREMENT_USER_PASSWORD=

# ------------------------------------------------------------
# ADMIN demo account
# ------------------------------------------------------------

ADMIN_USER_ID=
ADMIN_USER_EMAIL=
ADMIN_USER_PASSWORD=

# ------------------------------------------------------------
# SUPPORT demo account
# ------------------------------------------------------------

GERMES_SUPPORT_USER_ID=
GERMES_SUPPORT_EMAIL=
GERMES_SUPPORT_PASSWORD=