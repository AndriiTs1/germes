# Stage 6B one-time OWNER bootstrap (scripts/bootstrap-owner.ts) — variable
# NAMES only. Never commit real values. See .gitignore (.env* is ignored,
# this .env.example file is explicitly tracked as a template).

SUPABASE_SECRET_KEY=
GERMES_BOOTSTRAP_OWNER_ID=
GERMES_BOOTSTRAP_OWNER_EMAIL=
GERMES_BOOTSTRAP_OWNER_PASSWORD=

# Stage 8C.5 reusable internal-employee bootstrap (scripts/bootstrap-user.ts)
# — for any existing Germes User with at least one role (e.g. SALES).
# Shares SUPABASE_SECRET_KEY above. Variable NAMES only, never real values.
GERMES_BOOTSTRAP_USER_ID=
GERMES_BOOTSTRAP_USER_EMAIL=
GERMES_BOOTSTRAP_USER_PASSWORD=